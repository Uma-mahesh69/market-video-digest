{
  "firestore": {"rules": "firestore.rules"},
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "DENY"}]},
      {"source": "/vendor/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
      {"source": "/js/**", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "emulators": {"auth": {"port": 9099}, "firestore": {"port": 8080}, "hosting": {"port": 5000}, "ui": {"enabled": false}, "singleProjectMode": true}
}
