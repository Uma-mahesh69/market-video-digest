rules_version = '2';
// Who may read and write what. The engine uses an admin key and is not bound by these rules.
//
// PRIVATE BETA: only addresses on the members list (members/{email}, written by the engine from the BETA_MEMBERS
// secret) can see or save anything. Anyone can sign in with Google, but a signed-in address that is not a member
// reads nothing and writes nothing; it may only check its own membership and see or delete its own old account.
//   stocks, charts, market : the shared pages. Members read; nobody writes.
//   public                 : the example on the front page. Members only, while the beta is closed.
//   members/{email}        : the list. An address may read its own entry (to know whether it is in); nobody writes.
//   users/{uid}            : a member's own list and email choices. Only that member, and only in the expected shape.
//   requests/{ticker}      : "please start covering this stock". A member may add one.
//   feedback/{id}          : a note from the feedback box. A member may send one; nobody reads it from a browser
//                            (the engine emails the notes to the team and removes them).
//   videos, mail, engine   : the engine's own. No access from a browser.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function member() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(myEmail()));
    }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    function validPrefs(p) {
      return p is map && p.keys().hasOnly(['daily', 'weekly'])
        && (!('daily' in p) || p.daily in ['every', 'changes', 'off'])
        && (!('weekly' in p) || p.weekly is bool);
    }
    function validPaper(p) {
      return p is map && p.keys().hasOnly(['start_cash', 'cash', 'start', 'sp0', 'positions', 'trades'])
        && p.cash is number && p.positions is list && p.positions.size() <= 60 && p.trades is list && p.trades.size() <= 200;
    }
    function validUser(d) {
      return d.keys().hasOnly(['email', 'name', 'photo', 'stocks', 'follows', 'paper', 'prefs', 'onboarded', 'created', 'updated'])
        && d.email is string && d.email == request.auth.token.email   // emails only ever go to the address signed in with
        && (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('photo' in d) || (d.photo is string && d.photo.size() <= 600))
        && (!('stocks' in d) || (d.stocks is list && d.stocks.size() <= 60))
        && (!('follows' in d) || (d.follows is list && d.follows.size() <= 50))   // the analysts they follow, by name
        && (!('paper' in d) || validPaper(d.paper))                               // the practice portfolio (pretend money)
        && (!('prefs' in d) || validPrefs(d.prefs))
        && (!('onboarded' in d) || d.onboarded is bool)
        && (!('created' in d) || d.created is string)
        && (!('updated' in d) || d.updated is string);
    }

    match /stocks/{ticker} { allow read: if member(); }
    match /charts/{ticker} { allow read: if member(); }
    match /market/{page}   { allow read: if member(); }
    match /public/{page}   { allow read: if member(); }
    match /members/{email} { allow get: if signedIn() && request.auth.token.email != null && email == myEmail(); }

    match /users/{uid} {
      // a former member can still see and delete what they saved; only members can create or change an account
      allow get, delete: if mine(uid);
      allow create, update: if mine(uid) && member() && validUser(request.resource.data);
    }
    match /requests/{ticker} {
      allow create, update: if member() && ticker.matches('^[A-Z0-9._-]{1,15}$')
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by == request.auth.uid && request.resource.data.at is string;
    }
    match /feedback/{id} {
      allow create: if member() && id.matches('^[A-Za-z0-9_-]{8,40}$')
        && request.resource.data.keys().hasOnly(['by', 'email', 'text', 'page', 'at'])
        && request.resource.data.by == request.auth.uid && request.resource.data.email == request.auth.token.email
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.page is string && request.resource.data.page.size() <= 200 && request.resource.data.at is string;
    }
  }
}
